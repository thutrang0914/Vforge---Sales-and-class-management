# Copy to .env.db.local and .env.db.supabase (both gitignored), then fill in.
# Read only by scripts/db.sh. Claude must never open the real files.
#
# Supabase: Dashboard > Connect > Session pooler (or Direct connection).
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_USER=postgres.<project-ref>
#   DB_SSLMODE=require

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=disable
